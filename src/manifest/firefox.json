{
  "browser_specific_settings": {
    "gecko": {
      "id": "frost2x@frostr.org",
      "strict_min_version": "140.0"
    }
  },
  "background": {
    "service_worker": "background.build.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "nostr-provider.build.js"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
